{
  "name": "@bitapps/bit-connect",
  "version": "1.0.0",
  "license": "GPL-2.0-or-later",
  "author": "Bit Apps",
  "type": "module",
  "scripts": {
    "all:test": "pnpm ts && pnpm lint",
    "build": "pnpm build:free",
    "build:admin": "tsc -p frontend/admin/tsconfig.json && cross-env VITE_PRO=false vite build",
    "build:client": "tsc -p frontend/client/tsconfig.json && cross-env VITE_PRO=false vite build --config ./vite.config.client.mts",
    "build:free": "pnpm build:admin && pnpm build:client",
    "build:plugin": "node ./scripts/build-plugin.mjs --slug bit-connect --outdir build --zip --cleanbuild --noi18n",
    "build:silent": "pnpm build:free",
    "clean": "pnpm bitapps-plugin-clean-node",
    "dev": "pnpm concurrently \"pnpm dev:admin\" \"pnpm dev:client\"",
    "dev:admin": "cross-env VITE_PRO=false vite",
    "dev:client": "cross-env VITE_PRO=false vite --config ./vite.config.client.mts",
    "lint": "eslint frontend --fix",
    "lint:css": "stylelint frontend/**/*.{css,scss} --aei --color --fix",
    "lint:php": "composer lint",
    "pre-commit": "lefthook run pre-commit",
    "pretty": "npx prettier ./frontend/admin/src ./frontend/client/src --check",
    "pretty:fix": "npx prettier ./frontend/admin/src ./frontend/client/src --check --write",
    "preview": "vite preview",
    "prod:free": "node ./scripts/build-plugin.mjs --slug bit-connect --outdir build --noi18n",
    "prod:free-zip": "node ./scripts/build-plugin.mjs --slug bit-connect --outdir build --noi18n && node ./scripts/prune-build.mjs --slug bit-connect --outdir build && cd build && zip -rq bit-connect.zip bit-connect && cd .. && node ./scripts/rename-build-zip.mjs --slug bit-connect --outdir build",
    "production": "composer install --no-dev && pnpm install && pnpm build:free",
    "reset": "pnpm clean && pnpm install",
    "test": "pnpm test:admin && pnpm test:client",
    "test:admin": "vitest --watch=false -c ./vite.config.mts",
    "test:all": "pnpm test && pnpm test:php",
    "test:client": "vitest --watch=false -c ./vite.config.client.mts",
    "test:cover": "vitest --coverage --watch=false -c ./vite.config.mts && vitest --coverage --watch=false -c ./vite.config.client.mts",
    "test:e2e": "playwright test",
    "test:php": "composer test",
    "test:watch": "vitest --watch=true --ui=false -c ./vite.config.mts",
    "test:watch:client": "vitest --watch=true --ui=false -c ./vite.config.client.mts",
    "ts-check": "tsc && pnpm ts-check:admin && pnpm ts-check:client",
    "ts-check:admin": "tsc -p frontend/admin/tsconfig.json",
    "ts-check:client": "tsc -p frontend/client/tsconfig.json",
    "tw:prefix": "node scripts/add-tailwind-prefix.mjs",
    "tw:prefix:check": "node scripts/add-tailwind-prefix.mjs --dry-run",
    "type-cov": "pnpx type-coverage -p ./tsconfig.json --strict --details",
    "update-ver": "pnpm bitapps-plugin-update-version --slug bit-connect"
  },
