# Copy to `.env`. Every value here is optional — the build works without it.
#
# These configure the dev servers and the end-to-end tests against whatever
# WordPress install you are developing on.

# Where your WordPress install answers. Used as the base URL for the Playwright
# end-to-end tests (`pnpm test:e2e`).
DEV_DOMAIN=http://localhost

# Serve the Vite dev servers over HTTPS, for a WordPress install that is itself
# on HTTPS. Point both paths at a certificate your browser trusts (mkcert is the
# easy way); leave DEV_SSL unset to serve plain HTTP.
# DEV_SSL=true
# DEV_SSL_CERT_PATH=/path/to/cert.pem
# DEV_SSL_KEY_PATH=/path/to/key.pem

# Bind the dev servers to a hostname other than localhost.
# BIT_CONNECT_FRONTEND_ADMIN_HOST=localhost
# BIT_CONNECT_FRONTEND_CLIENT_HOST=localhost

# Name of the window global the PHP side prints the server payload onto. It must
# match Config::VAR_PREFIX in backend/app/Config.php, which is what Head.php and
# BaseView.php actually write. Both Vite configs default to this exact value, so
# set it only if you have changed VAR_PREFIX.
# SERVER_VARIABLES=bit_connect_
